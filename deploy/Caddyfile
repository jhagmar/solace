# Reverse-proxy / static hosting for Solace.
# Replace the site address and the `root` path, then:
#   caddy validate --config deploy/Caddyfile
#   caddy run --config deploy/Caddyfile
#
# Caddy obtains and renews HTTPS certificates automatically when the site
# address is a public hostname. Copy the Vite `dist/` tree to `root`.
#
# The `header` block is the production CSP and browser-isolation policy;
# it assumes `theme-boot.js` (not an inline script) and Open-Meteo as the
# only third-party origins. Do not add `preload` to HSTS until every
# subdomain of this host is HTTPS, and only then submit to hstspreload.org.

solace.example.com {
	root * /var/www/solace
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-DNS-Prefetch-Control "off"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
	}

	# Content-hashed Vite bundles never change at a given URL.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Caddy's file_server may omit Content-Type for .webmanifest; nosniff then
	# makes Chrome treat the manifest as text/plain.
	handle /manifest.webmanifest {
		header Cache-Control "no-cache"
		header Content-Type application/manifest+json
		file_server
	}

	# HTML, the service worker, theme-boot, and unhashed
	# icons must revalidate so a new release is picked up. Missing paths
	# fall through to index.html (SPA).
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
